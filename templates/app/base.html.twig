<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Webodrop Congés{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}?v={{ asset_version('images/favicon.png') }}">
    {% include 'home/styles.html.twig' %}
</head>
<body>
    <div class="lp-blobs"><span></span><span></span><span></span></div>

    {% include 'home/navbar.html.twig' %}

    <main class="lp-app-page">
        <div class="lp-container">
            {% block body %}{% endblock %}
        </div>
    </main>

    {% block modals %}{% endblock %}

    <footer class="lp-footer">
        <div class="lp-container">
            © {{ "now"|date('Y') }} Webodrop — Solution de gestion de congés
        </div>
    </footer>
</body>
</html>
