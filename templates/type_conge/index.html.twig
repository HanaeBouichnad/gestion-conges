{% extends 'base.html.twig' %}

{% block title %}Types de congé{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Types de congé</h1>
        <a href="{{ path('admin_type_conge_new') }}" class="btn btn-primary">Ajouter</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <table class="table table-striped">
        <thead><tr><th>Libellé</th><th>Pièce jointe obligatoire</th><th>Actif</th><th></th></tr></thead>
        <tbody>
            {% for type in types %}
                <tr>
                    <td>{{ type.libelle }}</td>
                    <td>{{ type.pieceJointeObligatoire ? 'Oui' : 'Non' }}</td>
                    <td>{{ type.actif ? 'Oui' : 'Non' }}</td>
                    <td><a href="{{ path('admin_type_conge_edit', {id: type.id}) }}">Modifier</a></td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}