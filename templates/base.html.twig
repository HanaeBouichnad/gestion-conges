<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <style>
            :root {
                --color-primary: #2E7DE1;
                --color-primary-light: #64B5F6;
                --color-surface: #F4F7FB;
                --color-text: #0F172A;
                --color-muted: #64748B;
                --color-brouillon: #94A3B8;
                --color-attente: #F59E0B;
                --color-approuve: #22C55E;
                --color-refuse: #EF4444;
                --color-annule: #8B5CF6;
                --font-display: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Arial, sans-serif;
                --font-mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
            }
            .font-display { font-family: var(--font-display); font-weight: 700; }
            .btn-stamp {
                background: var(--color-primary);
                color: #fff;
                border: none;
                border-radius: 8px;
                padding: 0.4rem 0.9rem;
                font-weight: 600;
                text-decoration: none;
                display: inline-block;
            }
            .btn-stamp:hover { background: #1E68C4; color: #fff; }
            .status-badge {
                display: inline-block;
                padding: 0.25rem 0.65rem;
                border-radius: 999px;
                font-size: 0.78rem;
                font-weight: 600;
                white-space: nowrap;
            }
            .status-badge.status-brouillon { background: rgba(148,163,184,0.15); color: var(--color-brouillon); }
            .status-badge.status-en_attente { background: rgba(245,158,11,0.15); color: var(--color-attente); }
            .status-badge.status-approuve { background: rgba(34,197,94,0.15); color: var(--color-approuve); }
            .status-badge.status-refuse { background: rgba(239,68,68,0.15); color: var(--color-refuse); }
            .status-badge.status-annule { background: rgba(139,92,246,0.15); color: var(--color-annule); }
        </style>
        {% block stylesheets %}
        {% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% if app.user %}
            <nav class="navbar navbar-expand navbar-dark bg-dark mb-3">
                <div class="container">
                    <a class="navbar-brand" href="{{ path('app_home') }}">Gestion des congés</a>
                    <div class="navbar-nav">
                        {% if is_granted('ROLE_ADMIN') %}
                            <a class="nav-link" href="{{ path('approbation_index') }}">Demandes à approuver</a>
                            <a class="nav-link" href="{{ path('admin_jour_ferie_index') }}">Jours fériés</a>
                            <a class="nav-link" href="{{ path('admin_type_conge_index') }}">Types de congé</a>
                        {% elseif is_granted('ROLE_RH') %}
                            <a class="nav-link" href="{{ path('demande_conge_index') }}">Mes demandes</a>
                            <a class="nav-link" href="{{ path('solde_mes_soldes') }}">Mes soldes</a>
                            <a class="nav-link" href="{{ path('calendrier_index') }}">Calendrier</a>
                            <a class="nav-link" href="{{ path('rh_demandes_toutes') }}">Toutes les demandes</a>
                            <a class="nav-link" href="{{ path('rh_demandes_approuvees') }}">Congés approuvés</a>
                            <a class="nav-link" href="{{ path('rh_soldes_index') }}">Gestion des soldes</a>
                            <a class="nav-link" href="{{ path('rh_export_csv') }}">Exporter CSV</a>
                        {% elseif is_granted('ROLE_RESPONSABLE') %}
                            <a class="nav-link" href="{{ path('demande_conge_index') }}">Mes demandes</a>
                            <a class="nav-link" href="{{ path('solde_mes_soldes') }}">Mes soldes</a>
                            <a class="nav-link" href="{{ path('calendrier_index') }}">Calendrier</a>
                            <a class="nav-link" href="{{ path('approbation_index') }}">Demandes à approuver</a>
                        {% else %}
                            <a class="nav-link" href="{{ path('demande_conge_index') }}">Mes demandes</a>
                            <a class="nav-link" href="{{ path('solde_mes_soldes') }}">Mes soldes</a>
                            <a class="nav-link" href="{{ path('calendrier_index') }}">Calendrier</a>
                        {% endif %}
                    </div>
                    <div class="navbar-nav ms-auto">
                        <span class="nav-link text-white-50">{{ app.user.nomComplet }}</span>
                        <a class="nav-link" href="{{ path('app_logout') }}">Déconnexion</a>
                    </div>
                </div>
            </nav>
        {% endif %}

        {% block body %}{% endblock %}
    </body>
</html>