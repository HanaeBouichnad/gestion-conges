{% extends 'base.html.twig' %}

{% block title %}Jours fériés{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Jours fériés</h1>
        <a href="{{ path('admin_jour_ferie_new') }}" class="btn btn-primary">Ajouter</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <table class="table table-striped">
        <thead><tr><th>Date</th><th>Libellé</th><th>Récurrent</th><th></th></tr></thead>
        <tbody>
            {% for jf in joursFeries %}
                <tr>
                    <td>{{ jf.date|date('d/m/Y') }}</td>
                    <td>{{ jf.libelle }}</td>
                    <td>{{ jf.recurrent ? 'Oui' : 'Non' }}</td>
                    <td>
                        <a href="{{ path('admin_jour_ferie_edit', {id: jf.id}) }}">Modifier</a>
                        <form method="post" action="{{ path('admin_jour_ferie_delete', {id: jf.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('supprimer' ~ jf.id) }}">
                            <button type="submit" class="btn btn-link p-0">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}