<nav class="lp-navbar">
    <div class="lp-navbar-inner">
        <a href="{{ path('app_home') }}" class="lp-logo">
            <img src="{{ asset('images/logo.png') }}" alt="Webodrop">
        </a>
        <div class="lp-nav-links">
            {% if app.user %}
                {% set currentRoute = app.current_route %}
                {% if not is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_home') }}" class="{{ currentRoute == 'app_home' ? 'lp-nav-link-active' }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>
                        Tableau de bord
                    </a>
                    <a href="{{ path('demande_conge_index') }}" class="{{ currentRoute starts with 'demande_conge_' ? 'lp-nav-link-active' }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4.5"/></svg>
                        Mes demandes
                    </a>
                    <a href="{{ path('calendrier_index') }}" class="{{ currentRoute starts with 'calendrier_' ? 'lp-nav-link-active' }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 10h18"/></svg>
                        Calendrier
                    </a>
                    <a href="{{ path('solde_mes_soldes') }}" class="{{ currentRoute starts with 'solde_' ? 'lp-nav-link-active' }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19V9M12 19V5M20 19v-7"/></svg>
                        Solde
                    </a>
                    {% if is_granted('ROLE_RESPONSABLE') %}
                        <a href="{{ path('approbation_index') }}" class="{{ currentRoute starts with 'approbation_' ? 'lp-nav-link-active' }}">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 10h18"/><circle cx="8" cy="15" r="1.4" fill="currentColor" stroke="none"/><circle cx="12" cy="15" r="1.4" fill="currentColor" stroke="none"/><circle cx="16" cy="15" r="1.4" fill="currentColor" stroke="none"/></svg>
                            Demandes d'approbation
                        </a>
                    {% endif %}
                    {% if is_granted('ROLE_RH') %}
                        <a href="{{ path('rh_annulation_index') }}" class="{{ currentRoute starts with 'rh_annulation_' ? 'lp-nav-link-active' }}">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9.5 12l1.8 1.8L15 10"/></svg>
                            Demandes d'annulation
                        </a>
                    {% endif %}
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_home') }}" class="{{ currentRoute == 'app_home' ? 'lp-nav-link-active' }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>
                        Tableau de bord
                    </a>
                    <a href="{{ path('admin_type_conge_index') }}" class="{{ currentRoute starts with 'admin_type_conge_' ? 'lp-nav-link-active' }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 4h11M9 12h11M9 20h11M4 4h.01M4 12h.01M4 20h.01"/></svg>
                        Types de congés
                    </a>
                    <a href="{{ path('admin_jour_ferie_index') }}" class="{{ currentRoute starts with 'admin_jour_ferie_' ? 'lp-nav-link-active' }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 10h18"/><path d="m12 13 1.5 3 3 .4-2.2 2.1.5 3-2.8-1.5-2.8 1.5.5-3-2.2-2.1 3-.4z"/></svg>
                        Jours fériés
                    </a>
                    <a href="{{ path('admin_user_index') }}" class="{{ currentRoute starts with 'admin_user_' ? 'lp-nav-link-active' }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        Utilisateurs
                    </a>
                {% endif %}
            {% else %}
                <a href="#a-propos" data-anchor-link>À propos</a>
                <a href="#fonctionnalites" data-anchor-link>Fonctionnalités</a>
            {% endif %}
        </div>
        <div class="lp-nav-actions">
            {% if app.user %}
                <div class="lp-user-menu">
                    <button type="button" class="lp-user-menu-toggle" data-user-menu-toggle>
                        {{ app.user.nomComplet }}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                    <div class="lp-user-menu-dropdown" data-user-menu-dropdown>
                        <a href="#">Profil</a>
                        <a href="{{ path('app_logout') }}">Déconnexion</a>
                    </div>
                </div>
            {% else %}
                <a href="{{ path('app_login') }}" class="lp-role-link" data-login-trigger>Administrateur</a>
                <a href="{{ path('app_login') }}" class="lp-role-link" data-login-trigger>Responsable</a>
                <a href="{{ path('app_login') }}" class="lp-role-link" data-login-trigger>RH</a>
                <a href="{{ path('app_login') }}" class="lp-role-link" data-login-trigger>Employé</a>
            {% endif %}
        </div>
    </div>
</nav>

<script>
(function () {
    document.querySelectorAll('[data-anchor-link]').forEach(function (link) {
        link.addEventListener('click', function (e) {
            var target = document.querySelector(link.getAttribute('href'));
            if (!target) { return; }
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    });
})();
</script>

{% if app.user %}
<script>
(function () {
    var toggle = document.querySelector('[data-user-menu-toggle]');
    var dropdown = document.querySelector('[data-user-menu-dropdown]');
    if (!toggle || !dropdown) { return; }

    toggle.addEventListener('click', function (e) {
        e.stopPropagation();
        dropdown.classList.toggle('lp-user-menu-open');
    });

    document.addEventListener('click', function (e) {
        if (!dropdown.contains(e.target) && e.target !== toggle) {
            dropdown.classList.remove('lp-user-menu-open');
        }
    });
})();
</script>
{% endif %}
