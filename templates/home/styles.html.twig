{% include '_fonts.html.twig' %}
<style>
    * { box-sizing: border-box; }
    html, body {
        margin: 0;
        padding: 0;
        background: #F8FAFC;
        color: #0F172A;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
        scroll-behavior: smooth;
    }
    a { color: inherit; }

    /* ---- Cercles décoratifs en fond ---- */
    .lp-blobs {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }
    .lp-blobs span {
        position: absolute;
        border-radius: 50%;
        filter: blur(2px);
        background: radial-gradient(circle at 30% 30%, rgba(46,125,225,0.12), rgba(46,125,225,0.03) 70%);
    }
    .lp-blobs span:nth-child(1) { width: 460px; height: 460px; top: -160px; right: -140px; }
    .lp-blobs span:nth-child(2) { width: 320px; height: 320px; top: 40%; left: -160px; }
    .lp-blobs span:nth-child(3) { width: 380px; height: 380px; bottom: -160px; right: 10%; }

    .lp-container { max-width: 1180px; margin: 0 auto; padding: 0 2rem; position: relative; z-index: 1; }

    /* ---- Navbar ---- */
    .lp-navbar {
        position: sticky;
        top: 0;
        z-index: 20;
        background: #EEF3FB;
        border-bottom: 1px solid #E2E8F0;
        box-shadow: 0 2px 12px rgba(15,23,42,0.06);
    }
    .lp-navbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 0.1rem 2rem 0.1rem 2rem;
    }
    .lp-logo { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; flex-shrink: 0; }
    .lp-logo img { height: 70px; width: auto; display: block; flex-shrink: 0; mix-blend-mode: multiply; }
    .lp-nav-links {
        display: flex;
        align-items: center;
        gap: 2.2rem;
        margin-left: auto;
        font-size: 0.92rem;
        font-weight: 600;
    }
    .lp-nav-links a {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        text-decoration: none;
        color: #334155;
        border-bottom: 2px solid transparent;
        padding-bottom: 0.35rem;
        transition: color 0.15s ease;
    }
    .lp-nav-links a:hover { color: #2E7DE1; }
    .lp-nav-links a svg { width: 16px; height: 16px; flex-shrink: 0; }
    .lp-nav-link-active { color: #2E7DE1 !important; border-bottom-color: #2E7DE1; }

    .lp-nav-actions { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; justify-content: flex-end; }
    .lp-role-link {
        font-size: 0.8rem;
        font-weight: 600;
        color: #334155;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: 999px;
        border: 1.5px solid #CBD5E1;
        white-space: nowrap;
        transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
    }
    .lp-role-link:hover { border-color: #2E7DE1; color: #2E7DE1; background: #F0F6FE; }

    .lp-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-weight: 600;
        font-size: 0.92rem;
        border-radius: 999px;
        padding: 0.65rem 1.4rem;
        text-decoration: none;
        cursor: pointer;
        border: 1.5px solid transparent;
        transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.15s ease;
        white-space: nowrap;
    }
    .lp-btn-primary {
        background: linear-gradient(135deg, #3aa6ef, #3aa6ef);
        color: #fff;
        box-shadow: 0 10px 22px -10px rgba(205, 227, 255, 0.55);
    }
    .lp-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 14px 26px -8px rgba(46,125,225,0.6); color: #fff; }
    .lp-btn-lg { padding: 0.85rem 1.9rem; font-size: 1rem; }
    .lp-btn-success {
        background: linear-gradient(135deg, #22C55E, #16A34A);
        color: #fff;
        box-shadow: 0 10px 22px -10px rgba(34,197,94,0.55);
    }
    .lp-btn-success:hover { transform: translateY(-1px); box-shadow: 0 14px 26px -8px rgba(34,197,94,0.6); color: #fff; }
    .lp-btn-danger {
        background: linear-gradient(135deg, #EF4444, #DC2626);
        color: #fff;
        box-shadow: 0 10px 22px -10px rgba(239,68,68,0.55);
    }
    .lp-btn-danger:hover { transform: translateY(-1px); box-shadow: 0 14px 26px -8px rgba(239,68,68,0.6); color: #fff; }

    /* ---- Hero ---- */
    .lp-hero { padding: 3.5rem 0 6.5rem; scroll-margin-top: 90px; }
    .lp-hero-grid {
        display: flex;
        justify-content: center;
    }
    .lp-hero-intro { max-width: 720px; margin: 0 auto; text-align: center; }
    .lp-badge {
        display: inline-block;
        background: #E9F1FD;
        color: #3aa6ef;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        padding: 0.45rem 1rem;
        border-radius: 999px;
        margin-bottom: 2rem;
    }
    .lp-hero-intro h1 {
        font-size: 3rem;
        font-weight: 800;
        line-height: 1.12;
        letter-spacing: -0.02em;
        margin: 0 0 1.3rem;
    }
    .lp-hero-intro p.lp-lead {
        color: #64748B;
        font-size: 1.1rem;
        line-height: 1.65;
        max-width: 480px;
        margin: 0 auto 2.2rem;
    }
    .lp-hero-ctas { display: flex; justify-content: center; gap: 1rem; margin-bottom: 2.8rem; flex-wrap: wrap; }

    .lp-reassurance-row { display: flex; justify-content: space-between; gap: 1.8rem; flex-wrap: wrap; }
    .lp-reassurance {
        display: flex;
        align-items: flex-start;
        gap: 0.7rem;
        max-width: 190px;
        text-align: left;
    }
    .lp-reassurance-icon {
        flex-shrink: 0;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: #E9F1FD;
        color: #2E7DE1;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .lp-reassurance-icon svg { width: 18px; height: 18px; }
    .lp-reassurance strong { display: block; font-size: 0.88rem; margin-bottom: 0.15rem; }
    .lp-reassurance span { font-size: 0.8rem; color: #64748B; line-height: 1.4; }

    /* ---- Section fonctionnalités ---- */
    .lp-features-section { padding: 2rem 0 6rem; scroll-margin-top: 60px; }
    .lp-section-head { text-align: center; max-width: 620px; margin: 0 auto 3.2rem; }
    .lp-section-head h2 { font-size: 2.2rem; font-weight: 800; letter-spacing: -0.01em; margin: 0 0 0.8rem; }
    .lp-section-head p { color: #64748B; font-size: 1.05rem; margin: 0; }

    .lp-features-cards {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.3rem;
    }
    .lp-feature-card {
        background: #fff;
        border: 1px solid #EEF2F7;
        border-radius: 18px;
        padding: 1.6rem;
        box-shadow: 0 16px 34px -22px rgba(15,23,42,0.15);
    }
    .lp-feature-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }
    .lp-feature-icon svg { width: 22px; height: 22px; }
    .lp-feature-card h3 { font-size: 1.05rem; font-weight: 700; margin: 0 0 0.5rem; }
    .lp-feature-card p { font-size: 0.88rem; color: #64748B; line-height: 1.55; margin: 0; }

    /* ---- Footer ---- */
    .lp-footer {
        border-top: 1px solid #E2E8F0;
        padding: 2rem 0;
        text-align: center;
        color: #94A3B8;
        font-size: 0.85rem;
        position: relative;
        z-index: 1;
    }

    /* ---- Modal de connexion ---- */
    .lp-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: rgba(15,23,42,0.45);
        backdrop-filter: blur(6px);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease;
    }
    .lp-modal-backdrop.lp-modal-open { opacity: 1; visibility: visible; }

    .login-card {
        position: relative;
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 25px 60px -15px rgba(17,24,39,0.25);
        padding: 2.6rem 2.4rem;
        width: 100%;
        max-width: 400px;
    }
    .lp-modal-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: none;
        background: #F1F5F9;
        color: #64748B;
        font-size: 1.2rem;
        line-height: 1;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .lp-modal-close:hover { background: #E2E8F0; color: #0F172A; }

    .login-card .card-logo {
        display: flex;
        justify-content: center;
        margin-bottom: 1.6rem;
    }
    .login-card .card-logo img { height: 56px; }

    .login-card h2 { font-size: 1.3rem; font-weight: 700; color: #111827; text-align: center; margin-bottom: 0.2rem; }
    .login-card .subtitle { text-align: center; color: #6B7280; font-size: 0.9rem; margin-bottom: 1.8rem; }

    .field-label { font-size: 0.82rem; font-weight: 600; color: #111827; margin-bottom: 0.35rem; display: block; }
    .field-icon-wrap { position: relative; margin-bottom: 1.2rem; }
    .field-icon-wrap svg {
        position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
        width: 18px; height: 18px; color: #9CA3AF;
    }
    .field-icon-wrap input {
        width: 100%;
        padding: 0.65rem 0.9rem 0.65rem 2.4rem;
        border: 1px solid #E5E9F0;
        border-radius: 10px;
        font-size: 0.95rem;
        box-sizing: border-box;
    }
    .field-icon-wrap input:focus {
        outline: none;
        border-color: #2E7DE1;
        box-shadow: 0 0 0 3px rgba(46,125,225,0.15);
    }
    .toggle-password {
        position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
        width: 18px; height: 18px; color: #9CA3AF; cursor: pointer; background: none; border: none; padding: 0;
    }

    .btn-webodrop {
        background: #2E7DE1;
        border: none;
        color: #fff;
        font-weight: 600;
        font-size: 0.95rem;
        border-radius: 10px;
        padding: 0.75rem;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: background 0.15s ease;
        cursor: pointer;
        margin-top: 0.4rem;
    }
    .btn-webodrop:hover { background: #1E68C4; color: #fff; }

    /* ---- Menu utilisateur (navbar connectée) ---- */
    .lp-user-menu { position: relative; }
    .lp-user-menu-toggle {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.88rem;
        font-weight: 600;
        color: #0F172A;
        background: #fff;
        border: 1.5px solid #CBD5E1;
        border-radius: 999px;
        padding: 0.5rem 1rem;
        cursor: pointer;
    }
    .lp-user-menu-toggle:hover { border-color: #2E7DE1; }
    .lp-user-menu-toggle svg { width: 14px; height: 14px; }
    .lp-user-menu-dropdown {
        position: absolute;
        top: calc(100% + 0.5rem);
        right: 0;
        background: #fff;
        border: 1px solid #EEF2F7;
        border-radius: 12px;
        box-shadow: 0 16px 34px -14px rgba(15,23,42,0.25);
        min-width: 170px;
        padding: 0.4rem;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-4px);
        transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease;
        z-index: 30;
    }
    .lp-user-menu-dropdown.lp-user-menu-open { opacity: 1; visibility: visible; transform: translateY(0); }
    .lp-user-menu-dropdown a {
        display: block;
        padding: 0.55rem 0.7rem;
        border-radius: 8px;
        font-size: 0.88rem;
        font-weight: 600;
        color: #334155;
        text-decoration: none;
    }
    .lp-user-menu-dropdown a:hover { background: #F0F6FE; color: #2E7DE1; }

    /* ---- Dashboard (utilisateur connecté) ---- */
    .lp-btn-sm { padding: 0.45rem 1rem; font-size: 0.85rem; }
    .lp-dashboard { padding: 3rem 0 5rem; position: relative; z-index: 1; }
    .lp-dashboard-header { margin-bottom: 2.2rem; }
    .lp-eyebrow {
        display: block;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.78rem;
        color: #64748B;
        margin-bottom: 0.3rem;
        font-weight: 600;
    }
    .lp-dashboard-header h1 { font-size: 2rem; font-weight: 800; margin: 0 0 0.35rem; letter-spacing: -0.01em; }
    .lp-dashboard-subtitle { display: block; font-size: 0.98rem; color: #64748B; }
    .lp-dashboard-subhead { font-size: 1.2rem; font-weight: 700; margin: 0; }
    .lp-dashboard-section { margin-top: 2.6rem; }
    .lp-dashboard-section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }

    .lp-dashboard-hero { display: flex; align-items: center; justify-content: space-between; gap: 2.5rem; margin-bottom: 2.2rem; }
    .lp-dashboard-hero-text { flex: 1; min-width: 0; }
    .lp-dashboard-hero-text .lp-dashboard-header { margin-bottom: 1.4rem; }
    .lp-dashboard-hero-text .lp-info-banner { margin: 0 0 1.4rem; }
    .lp-dashboard-hero-text .lp-dashboard-cta { margin-bottom: 0; }
    .lp-dashboard-hero-image { flex-shrink: 0; }
    .lp-dashboard-hero-image img { display: block; width: 100%; max-width: 300px; height: auto; }

    .lp-info-banner {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        background: #E9F1FD;
        border-radius: 14px;
        padding: 0.9rem 1.2rem;
        margin: 1.6rem 0 1.4rem;
    }
    .lp-info-banner-icon {
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        border-radius: 10px;
        background: rgba(46,125,225,0.15);
        color: #2E7DE1;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .lp-info-banner-icon svg { width: 17px; height: 17px; }
    .lp-info-banner p { margin: 0; font-size: 0.92rem; color: #1E3A5F; }
    .lp-info-banner strong { color: #2E7DE1; }

    .lp-dashboard-cta { margin-bottom: 2.2rem; }
    .lp-dashboard-cta svg { width: 16px; height: 16px; }

    .lp-dash-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.3rem; margin-bottom: 1rem; }
    .lp-dash-card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        background: #fff;
        border: 1px solid #EEF2F7;
        border-radius: 18px;
        padding: 1.5rem;
        box-shadow: 0 16px 34px -22px rgba(15,23,42,0.15);
        text-decoration: none;
        color: #0F172A;
        transition: transform 0.12s ease, box-shadow 0.12s ease, border-color 0.12s ease;
    }
    .lp-dash-card:hover { transform: translateY(-2px); box-shadow: 0 20px 40px -18px rgba(15,23,42,0.2); border-color: #CBD5E1; color: #0F172A; }
    .lp-dash-card-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.9rem;
    }
    .lp-dash-card-icon svg { width: 21px; height: 21px; }
    .lp-dash-card h3 { font-size: 1rem; font-weight: 700; margin: 0 0 0.4rem; }
    .lp-dash-card-value { font-size: 1.9rem; font-weight: 800; line-height: 1; margin-bottom: 0.3rem; }
    .lp-dash-card-meta { font-size: 0.86rem; color: #64748B; margin: 0 0 0.7rem; line-height: 1.5; }
    .lp-dash-card .lp-see-more { margin-top: auto; }
    .lp-dash-card-wide {
        grid-column: 1 / -1;
        flex-direction: row;
        align-items: center;
        gap: 1rem;
    }
    .lp-dash-card-wide .lp-dash-card-icon { margin-bottom: 0; }
    .lp-dash-card-wide h3 { margin-bottom: 0.2rem; }
    .lp-dash-card-wide .lp-dash-card-meta { margin: 0; }
    .lp-dash-card-wide .lp-see-more { margin-left: auto; white-space: nowrap; }

    .lp-kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; margin-bottom: 2.6rem; }
    .lp-kpi-card {
        background: #fff;
        border: 1px solid #EEF2F7;
        border-left: 4px solid var(--lp-kpi-color, #2E7DE1);
        border-radius: 16px;
        padding: 1.3rem 1.4rem;
        box-shadow: 0 16px 34px -22px rgba(15,23,42,0.15);
    }
    .lp-kpi-value { font-size: 1.9rem; font-weight: 800; line-height: 1; margin-bottom: 0.35rem; }
    .lp-kpi-label { font-size: 0.82rem; color: #64748B; }
    .lp-kpi-link { display: inline-block; margin-top: 0.6rem; font-size: 0.82rem; font-weight: 600; color: #2E7DE1; text-decoration: none; }
    .lp-kpi-link:hover { text-decoration: underline; }

    /* ---- Cartes "Détail par type" (page Solde) ---- */
    .lp-type-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.1rem; margin-bottom: 2.6rem; }
    .lp-type-card {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 0.55rem;
        padding: 1.6rem 1.1rem 1.5rem;
        border-radius: 20px;
        color: var(--lp-type-deep);
        background: linear-gradient(160deg, var(--lp-type-bg-start), var(--lp-type-bg-end));
        border: 1px solid var(--lp-type-border);
        box-shadow: 0 14px 28px -22px rgba(15,23,42,0.25);
    }
    .lp-type-card--annuel {
        --lp-type-bg-start: #F6F2FE; --lp-type-bg-end: #EEE6FC; --lp-type-border: #E1D5FA;
        --lp-type-deep: #6D28D9; --lp-type-icon-bg: #8B5CF6; --lp-type-badge-bg: #EBE0FC; --lp-type-wave: #FBF9FF;
    }
    .lp-type-card--maladie {
        --lp-type-bg-start: #F0F7FE; --lp-type-bg-end: #E3EFFC; --lp-type-border: #D3E6FB;
        --lp-type-deep: #1D4ED8; --lp-type-icon-bg: #2E7DE1; --lp-type-badge-bg: #DEECFC; --lp-type-wave: #F8FBFF;
    }
    .lp-type-card--recuperation {
        --lp-type-bg-start: #F1FCF5; --lp-type-bg-end: #E4F9EB; --lp-type-border: #D2F2DC;
        --lp-type-deep: #15803D; --lp-type-icon-bg: #22C55E; --lp-type-badge-bg: #DEF7E6; --lp-type-wave: #F9FEFB;
    }
    .lp-type-card--exceptionnel {
        --lp-type-bg-start: #FFFBEF; --lp-type-bg-end: #FEF3D8; --lp-type-border: #FBE7B4;
        --lp-type-deep: #92620A; --lp-type-icon-bg: #F59E0B; --lp-type-badge-bg: #FCECC4; --lp-type-wave: #FFFDF6;
    }
    .lp-type-card--sans-solde {
        --lp-type-bg-start: #FEF4F3; --lp-type-bg-end: #FCE6E5; --lp-type-border: #F9D2D0;
        --lp-type-deep: #B91C1C; --lp-type-icon-bg: #EF4444; --lp-type-badge-bg: #FBDBDA; --lp-type-wave: #FFF9F8;
    }
    .lp-type-card--defaut {
        --lp-type-bg-start: #F8FAFC; --lp-type-bg-end: #EEF2F7; --lp-type-border: #E1E8F0;
        --lp-type-deep: #475569; --lp-type-icon-bg: #94A3B8; --lp-type-badge-bg: #E7ECF3; --lp-type-wave: #FCFDFE;
    }

    .lp-type-card-icon {
        position: relative;
        z-index: 1;
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background: var(--lp-type-icon-bg);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .lp-type-card-icon svg { width: 26px; height: 26px; }
    .lp-type-card-label { position: relative; z-index: 1; font-size: 0.86rem; font-weight: 700; }
    .lp-type-card-value { position: relative; z-index: 1; font-size: 1.9rem; font-weight: 800; line-height: 1; }
    .lp-type-card-value span { font-size: 0.8rem; font-weight: 600; opacity: 0.75; margin-left: 0.2rem; }
    .lp-type-card-badge {
        position: relative;
        z-index: 1;
        display: inline-block;
        margin-top: 0.15rem;
        padding: 0.3rem 0.85rem;
        border-radius: 999px;
        background: var(--lp-type-badge-bg);
        color: var(--lp-type-deep);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.03em;
    }
    .lp-type-card-wave { position: absolute; left: 0; bottom: 0; width: 100%; height: 34px; z-index: 0; }
    .lp-type-card-wave path { fill: var(--lp-type-wave); }

    .lp-dashboard-date-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        background: #fff;
        border: 1px solid #EEF2F7;
        border-radius: 999px;
        padding: 0.55rem 1.1rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: #334155;
        box-shadow: 0 12px 26px -18px rgba(15,23,42,0.2);
        white-space: nowrap;
    }
