<style>
    * { box-sizing: border-box; }
    html, body {
        margin: 0;
        padding: 0;
        background: #F8FAFC;
        color: #0F172A;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Arial, sans-serif;
        scroll-behavior: smooth;
    }
    a { color: inherit; }

    /* ---- Cercles décoratifs en fond ---- */
    .lp-blobs {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }
    .lp-blobs span {
        position: absolute;
        border-radius: 50%;
        filter: blur(2px);
        background: radial-gradient(circle at 30% 30%, rgba(46,125,225,0.12), rgba(46,125,225,0.03) 70%);
    }
    .lp-blobs span:nth-child(1) { width: 460px; height: 460px; top: -160px; right: -140px; }
    .lp-blobs span:nth-child(2) { width: 320px; height: 320px; top: 40%; left: -160px; }
    .lp-blobs span:nth-child(3) { width: 380px; height: 380px; bottom: -160px; right: 10%; }

    .lp-container { max-width: 1180px; margin: 0 auto; padding: 0 2rem; position: relative; z-index: 1; }

    /* ---- Navbar ---- */
    .lp-navbar {
        position: sticky;
        top: 0;
        z-index: 20;
        background: #EEF3FB;
        border-bottom: 1px solid #E2E8F0;
        box-shadow: 0 2px 12px rgba(15,23,42,0.06);
    }
    .lp-navbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 0.1rem 2rem 0.1rem 2rem;
    }
    .lp-logo { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; flex-shrink: 0; }
    .lp-logo img { height: 70px; width: auto; display: block; flex-shrink: 0; mix-blend-mode: multiply; }
    .lp-nav-links {
        display: flex;
        align-items: center;
        gap: 3rem;
        margin-left: auto;
        font-size: 0.92rem;
        font-weight: 600;
    }
    .lp-nav-links a { text-decoration: none; color: #334155; transition: color 0.15s ease; }
    .lp-nav-links a:hover { color: #2E7DE1; }

    .lp-nav-actions { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; justify-content: flex-end; }
    .lp-role-link {
        font-size: 0.8rem;
        font-weight: 600;
        color: #334155;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: 999px;
        border: 1.5px solid #CBD5E1;
        white-space: nowrap;
        transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
    }
    .lp-role-link:hover { border-color: #2E7DE1; color: #2E7DE1; background: #F0F6FE; }

    .lp-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-weight: 600;
        font-size: 0.92rem;
        border-radius: 999px;
        padding: 0.65rem 1.4rem;
        text-decoration: none;
        cursor: pointer;
        border: 1.5px solid transparent;
        transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.15s ease;
        white-space: nowrap;
    }
    .lp-btn-primary {
        background: linear-gradient(135deg, #2E7DE1, #1E68C4);
        color: #fff;
        box-shadow: 0 10px 22px -10px rgba(46,125,225,0.55);
    }
    .lp-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 14px 26px -8px rgba(46,125,225,0.6); color: #fff; }
    .lp-btn-lg { padding: 0.85rem 1.9rem; font-size: 1rem; }

    /* ---- Hero ---- */
    .lp-hero { padding: 3.5rem 0 6.5rem; }
    .lp-hero-grid {
        display: flex;
        justify-content: center;
    }
    .lp-hero-intro { max-width: 720px; margin: 0 auto; text-align: center; }
    .lp-badge {
        display: inline-block;
        background: #E9F1FD;
        color: #2E7DE1;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        padding: 0.45rem 1rem;
        border-radius: 999px;
        margin-bottom: 0.6rem;
    }
    .lp-hero-intro h1 {
        font-size: 3rem;
        font-weight: 800;
        line-height: 1.12;
        letter-spacing: -0.02em;
        margin: 0 0 1.3rem;
    }
    .lp-hero-intro p.lp-lead {
        color: #64748B;
        font-size: 1.1rem;
        line-height: 1.65;
        max-width: 480px;
        margin: 0 auto 2.2rem;
    }
    .lp-hero-ctas { display: flex; justify-content: center; gap: 1rem; margin-bottom: 2.8rem; flex-wrap: wrap; }

    .lp-reassurance-row { display: flex; justify-content: space-between; gap: 1.8rem; flex-wrap: wrap; }
    .lp-reassurance {
        display: flex;
        align-items: flex-start;
        gap: 0.7rem;
        max-width: 190px;
        text-align: left;
    }
    .lp-reassurance-icon {
        flex-shrink: 0;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: #E9F1FD;
        color: #2E7DE1;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .lp-reassurance-icon svg { width: 18px; height: 18px; }
    .lp-reassurance strong { display: block; font-size: 0.88rem; margin-bottom: 0.15rem; }
    .lp-reassurance span { font-size: 0.8rem; color: #64748B; line-height: 1.4; }

    /* ---- Section fonctionnalités ---- */
    .lp-features-section { padding: 5rem 0 6rem; }
    .lp-section-head { text-align: center; max-width: 620px; margin: 0 auto 3.2rem; }
    .lp-section-head h2 { font-size: 2.2rem; font-weight: 800; letter-spacing: -0.01em; margin: 0 0 0.8rem; }
    .lp-section-head p { color: #64748B; font-size: 1.05rem; margin: 0; }

    .lp-features-cards {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.3rem;
    }
    .lp-feature-card {
        background: #fff;
        border: 1px solid #EEF2F7;
        border-radius: 18px;
        padding: 1.6rem;
        box-shadow: 0 16px 34px -22px rgba(15,23,42,0.15);
    }
    .lp-feature-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }
    .lp-feature-icon svg { width: 22px; height: 22px; }
    .lp-feature-card h3 { font-size: 1.05rem; font-weight: 700; margin: 0 0 0.5rem; }
    .lp-feature-card p { font-size: 0.88rem; color: #64748B; line-height: 1.55; margin: 0; }

    /* ---- Footer ---- */
    .lp-footer {
        border-top: 1px solid #E2E8F0;
        padding: 2rem 0;
        text-align: center;
        color: #94A3B8;
        font-size: 0.85rem;
        position: relative;
        z-index: 1;
    }

    /* ---- Modal de connexion ---- */
    .lp-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: rgba(15,23,42,0.45);
        backdrop-filter: blur(6px);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease;
    }
    .lp-modal-backdrop.lp-modal-open { opacity: 1; visibility: visible; }

    .login-card {
        position: relative;
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 25px 60px -15px rgba(17,24,39,0.25);
        padding: 2.6rem 2.4rem;
        width: 100%;
        max-width: 400px;
    }
    .lp-modal-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: none;
        background: #F1F5F9;
        color: #64748B;
        font-size: 1.2rem;
        line-height: 1;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .lp-modal-close:hover { background: #E2E8F0; color: #0F172A; }

    .login-card .card-logo {
        display: flex;
        justify-content: center;
        margin-bottom: 1.6rem;
    }
    .login-card .card-logo img { height: 56px; }

    .login-card h2 { font-size: 1.3rem; font-weight: 700; color: #111827; text-align: center; margin-bottom: 0.2rem; }
    .login-card .subtitle { text-align: center; color: #6B7280; font-size: 0.9rem; margin-bottom: 1.8rem; }

    .field-label { font-size: 0.82rem; font-weight: 600; color: #111827; margin-bottom: 0.35rem; display: block; }
    .field-icon-wrap { position: relative; margin-bottom: 1.2rem; }
    .field-icon-wrap svg {
        position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
        width: 18px; height: 18px; color: #9CA3AF;
    }
    .field-icon-wrap input {
        width: 100%;
        padding: 0.65rem 0.9rem 0.65rem 2.4rem;
        border: 1px solid #E5E9F0;
        border-radius: 10px;
        font-size: 0.95rem;
        box-sizing: border-box;
    }
    .field-icon-wrap input:focus {
        outline: none;
        border-color: #2E7DE1;
        box-shadow: 0 0 0 3px rgba(46,125,225,0.15);
    }
    .toggle-password {
        position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
        width: 18px; height: 18px; color: #9CA3AF; cursor: pointer; background: none; border: none; padding: 0;
    }

    .btn-webodrop {
        background: #2E7DE1;
        border: none;
        color: #fff;
        font-weight: 600;
        font-size: 0.95rem;
        border-radius: 10px;
        padding: 0.75rem;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: background 0.15s ease;
        cursor: pointer;
        margin-top: 0.4rem;
    }
    .btn-webodrop:hover { background: #1E68C4; color: #fff; }

    @media (max-width: 980px) {
        .lp-hero-intro { max-width: 100%; }
        .lp-nav-links { display: none; }
    }
    @media (max-width: 640px) {
        .lp-features-cards { grid-template-columns: 1fr; max-width: 420px; }
    }
    @media (max-width: 560px) {
        .lp-hero-intro h1 { font-size: 2.2rem; }
        .lp-hero-ctas { flex-direction: column; align-items: stretch; }
        .lp-nav-actions { justify-content: center; }
    }
</style>
