<div class="lp-blobs"><span></span><span></span><span></span></div>

{% include 'home/navbar.html.twig' %}

<main class="lp-dashboard">
    <div class="lp-container">
        {% set joursSemaine = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'] %}
        {% set moisAnnee = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] %}

        {% if vueAdmin %}
            <div class="lp-dashboard-header">
                <h1>Bonjour {{ app.user.prenom }}</h1>
                <span class="lp-dashboard-subtitle">{{ joursSemaine[("now"|date('N')) - 1] }} {{ "now"|date('j') }} {{ moisAnnee[("now"|date('n')) - 1] }} {{ "now"|date('Y') }}</span>
            </div>

            <div class="lp-kpi-grid">
                <div class="lp-kpi-card" style="--lp-kpi-color:#2E7DE1;">
                    <div class="lp-kpi-value">{{ nbJoursFeries }}</div>
                    <div class="lp-kpi-label">Jours fériés configurés</div>
                    <a href="{{ path('admin_jour_ferie_index') }}" class="lp-kpi-link">Gérer &rarr;</a>
                </div>
                <div class="lp-kpi-card" style="--lp-kpi-color:#64B5F6;">
                    <div class="lp-kpi-value">{{ nbTypesConge }}</div>
                    <div class="lp-kpi-label">Types de congé actifs</div>
                    <a href="{{ path('admin_type_conge_index') }}" class="lp-kpi-link">Gérer &rarr;</a>
                </div>
                <div class="lp-kpi-card" style="--lp-kpi-color:#F59E0B;">
                    <div class="lp-kpi-value">{{ aApprouver|length }}</div>
                    <div class="lp-kpi-label">Demandes à approuver</div>
                    <a href="{{ path('approbation_index') }}" class="lp-kpi-link">Voir &rarr;</a>
                </div>
            </div>

            {% if aApprouver is not empty %}
                <h2 class="lp-dashboard-subhead">En attente de ta validation</h2>
                <div>
                    {% for demande in aApprouver|slice(0, 5) %}
                        <div class="lp-list-item">
                            <div>
                                <strong>{{ demande.employe.nomComplet }}</strong> — {{ demande.typeConge.libelle }}
                                <span class="lp-list-meta">({{ demande.dateDebut|date('d/m') }} au {{ demande.dateFin|date('d/m/Y') }})</span>
                            </div>
                            <a href="{{ path('approbation_index') }}" class="lp-btn lp-btn-primary lp-btn-sm">Traiter</a>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% else %}
            <div class="lp-dashboard-hero">
                <div class="lp-dashboard-hero-text">
                    <div class="lp-dashboard-header">
                        <h1>Bonjour {{ app.user.prenom }}</h1>
                        <span class="lp-dashboard-subtitle">{{ joursSemaine[("now"|date('N')) - 1] }} {{ "now"|date('j') }} {{ moisAnnee[("now"|date('n')) - 1] }} {{ "now"|date('Y') }}</span>
                    </div>

                    <div class="lp-info-banner">
                        <div class="lp-info-banner-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 10h18"/></svg>
                        </div>
                        <p>Vous avez <strong>{{ soldeCongeAnnuel }}</strong> jours de congé annuel disponibles.</p>
                    </div>

                    <a href="{{ path('demande_conge_new') }}" class="lp-btn lp-btn-primary lp-dashboard-cta">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                        Nouvelle demande de congé
                    </a>
                </div>

                <div class="lp-dashboard-hero-image">
                    <img src="{{ asset('images/calendrier.png') }}" alt="">
                </div>
            </div>

            <div class="lp-dash-cards">
                <a href="{{ path('solde_mes_soldes') }}" class="lp-dash-card">
                    <div class="lp-dash-card-icon" style="background:#E9FBF1; color:#22C55E;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19V9M12 19V5M20 19v-7"/></svg>
                    </div>
                    <h3>Solde de congé annuel</h3>
                    <div class="lp-dash-card-value">{{ soldeCongeAnnuel }}</div>
                    <p class="lp-dash-card-meta">jours disponibles</p>
                    <span class="lp-see-more">Voir le détail du solde &rarr;</span>
                </a>

                <a href="{{ path('calendrier_index') }}" class="lp-dash-card">
                    <div class="lp-dash-card-icon" style="background:#E9F1FD; color:#2E7DE1;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 10h18"/></svg>
                    </div>
                    <h3>Prochaine absence</h3>
                    {% if prochaineAbsence %}
                        <div class="lp-dash-card-value" style="font-size:1.3rem;">{{ prochaineAbsence.dateDebut|date('d/m') }} au {{ prochaineAbsence.dateFin|date('d/m/Y') }}</div>
                        <p class="lp-dash-card-meta">{{ prochaineAbsence.typeConge.libelle }}</p>
                    {% else %}
                        <p class="lp-dash-card-meta" style="margin-top:0.6rem;">Aucune absence prévue</p>
                    {% endif %}
                    <span class="lp-see-more">Voir le calendrier &rarr;</span>
                </a>

                <a href="{{ path('demande_conge_index') }}" class="lp-dash-card">
                    <div class="lp-dash-card-icon" style="background:#FEF3E4; color:#F59E0B;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4.5"/></svg>
                    </div>
                    <h3>Mes demandes</h3>
                    <p class="lp-dash-card-meta">{{ counts.approuve }} approuvée{{ counts.approuve > 1 ? 's' : '' }}, {{ counts.brouillon }} brouillon{{ counts.brouillon > 1 ? 's' : '' }}, {{ counts.en_attente }} en attente</p>
                    <span class="lp-see-more">Voir toutes mes demandes &rarr;</span>
                </a>

                <a href="{{ path('calendrier_index') }}" class="lp-dash-card">
                    <div class="lp-dash-card-icon" style="background:#F3E9FD; color:#8B5CF6;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/><circle cx="8" cy="15" r="1.4" fill="currentColor" stroke="none"/><circle cx="12" cy="15" r="1.4" fill="currentColor" stroke="none"/><circle cx="16" cy="15" r="1.4" fill="currentColor" stroke="none"/></svg>
                    </div>
                    <h3>Calendrier des absences</h3>
                    <p class="lp-dash-card-meta">Visualisez les absences et jours fériés de toute l'équipe.</p>
                    <span class="lp-see-more">Voir le calendrier &rarr;</span>
                </a>

                {% if is_granted('ROLE_RESPONSABLE') %}
                    <a href="{{ path('approbation_index') }}" class="lp-dash-card lp-dash-card-wide">
                        <div class="lp-dash-card-icon" style="background:#FDECEC; color:#EF4444;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9.5 12l1.8 1.8L15 10"/></svg>
                        </div>
                        <div>
                            <h3>À approuver</h3>
                            <p class="lp-dash-card-meta">{{ aApprouver|length }} demande{{ aApprouver|length > 1 ? 's' : '' }} en attente de ta validation</p>
                        </div>
                        <span class="lp-see-more">Traiter &rarr;</span>
                    </a>
                {% endif %}
            </div>

            <div class="lp-dashboard-section">
                <div class="lp-dashboard-section-head">
                    <h2 class="lp-dashboard-subhead">Mes dernières demandes</h2>
                    <a href="{{ path('demande_conge_index') }}" class="lp-see-more">Voir toutes &rarr;</a>
                </div>
                {% if mesDemandesRecentes is empty %}
                    <div class="lp-list-empty">
                        <p>Aucune demande pour le moment.</p>
                        <a href="{{ path('demande_conge_new') }}" class="lp-btn lp-btn-primary lp-btn-sm">+ Nouvelle demande</a>
                    </div>
                {% else %}
                    {% for demande in mesDemandesRecentes %}
                        <a href="{{ path('demande_conge_show', {id: demande.id}) }}" class="lp-list-item">
                            <span class="lp-list-status-icon {{ demande.statut.value == 'approuve' ? 'is-approved' : '' }}">
                                {% if demande.statut.value == 'approuve' %}
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12l4 4L19 6"/></svg>
                                {% else %}
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="8"/></svg>
                                {% endif %}
                            </span>
                            <div class="lp-list-item-body">
                                <strong>{{ demande.typeConge.libelle }}</strong>
                                <span class="lp-list-meta">{{ demande.dateDebut|date('d/m') }} au {{ demande.dateFin|date('d/m/Y') }}</span>
                            </div>
                            <span class="status-badge status-{{ demande.statut.value }}">{{ demande.statut.label }}</span>
                            <span class="lp-list-meta lp-list-date">{{ (demande.dateModification ?? demande.dateCreation)|date('d/m/Y') }}</span>
                            <svg class="lp-list-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
                        </a>
                    {% endfor %}
                {% endif %}
            </div>

            <div class="lp-dashboard-section">
                <h2 class="lp-dashboard-subhead">Répartition de mon solde</h2>
                <div class="lp-feature-card">
                    {% set totalJours = 0 %}
                    {% for s in mesSoldes %}{% set totalJours = totalJours + s.solde %}{% endfor %}

                    {% if totalJours > 0 %}
                        <div class="lp-solde-bar">
                            {% for s in mesSoldes %}
                                {% if s.solde > 0 %}
                                    <div style="width: {{ (s.solde / totalJours * 100) }}%; background: hsl({{ loop.index0 * 70 }}, 45%, 40%);"></div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endif %}

                    {% for s in mesSoldes %}
                        <div class="lp-solde-legend">
                            <span><span class="lp-solde-dot" style="background: hsl({{ loop.index0 * 70 }}, 45%, 40%);"></span>{{ s.typeConge.libelle }}</span>
                            <strong>{{ s.solde }} j</strong>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
</main>

<footer class="lp-footer">
    <div class="lp-container">
        © {{ "now"|date('Y') }} Webodrop — Solution de gestion de congés
    </div>
</footer>
