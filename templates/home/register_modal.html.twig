<div class="lp-modal-backdrop{% if modalOpen %} lp-modal-open{% endif %}" id="lp-register-modal" data-close-mode="{{ modalOpen ? 'navigate' : 'hide' }}" data-close-href="{{ path('app_login') }}">
    <div class="login-card" role="dialog" aria-modal="true" aria-labelledby="lp-register-title">
        <div class="login-card-header">
            <button type="button" class="lp-modal-close" aria-label="Fermer" data-register-close>&times;</button>

            <div class="card-logo">
                <img src="{{ asset('images/logo.png') }}" alt="Webodrop">
            </div>

            <h2 id="lp-register-title">Créer un compte</h2>
            <p class="subtitle">Votre compte sera activé après validation par un administrateur</p>
        </div>

        <div class="field-error">{{ form_errors(form) }}</div>

        {{ form_start(form, {'action': path('app_register'), 'attr': {'novalidate': 'novalidate'}}) }}
            <label class="field-label">Prénom</label>
            <div class="field-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/></svg>
                {{ form_widget(form.prenom, {'attr': {'placeholder': 'Votre prénom', 'autofocus': true}}) }}
            </div>
            <div class="field-error">{{ form_errors(form.prenom) }}</div>

            <label class="field-label">Nom</label>
            <div class="field-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/></svg>
                {{ form_widget(form.nom, {'attr': {'placeholder': 'Votre nom'}}) }}
            </div>
            <div class="field-error">{{ form_errors(form.nom) }}</div>

            <label class="field-label">Adresse e-mail</label>
            <div class="field-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                {{ form_widget(form.email, {'attr': {'placeholder': 'votre@email.com'}}) }}
            </div>
            <div class="field-error">{{ form_errors(form.email) }}</div>

            <label class="field-label">Rôle</label>
            <div class="field-select">
                {{ form_widget(form.rolePrincipal) }}
            </div>
            <div class="field-error">{{ form_errors(form.rolePrincipal) }}</div>

            <label class="field-label">Mot de passe</label>
            <div class="field-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M7 10V7a5 5 0 0 1 10 0v3"/></svg>
                {{ form_widget(form.plainPassword.first, {'id': 'register-password-field', 'attr': {'placeholder': '••••••••••••'}}) }}
                <button type="button" class="toggle-password" onclick="lpToggleRegisterPassword()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
            </div>
            <div class="field-error">{{ form_errors(form.plainPassword.first) }}</div>

            <label class="field-label">Confirmation du mot de passe</label>
            <div class="field-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M7 10V7a5 5 0 0 1 10 0v3"/></svg>
                {{ form_widget(form.plainPassword.second, {'id': 'register-password-confirm-field', 'attr': {'placeholder': '••••••••••••'}}) }}
                <button type="button" class="toggle-password" onclick="lpToggleRegisterPasswordConfirm()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
            </div>
            <div class="field-error">{{ form_errors(form.plainPassword.second) }}</div>

            <button type="submit" class="btn-webodrop">
                S'inscrire
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
        {{ form_end(form) }}

        <p class="lp-modal-alt-action">Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a></p>
    </div>
</div>

<script>
(function () {
    var backdrop = document.getElementById('lp-register-modal');
    if (!backdrop) { return; }

    function closeModal() {
        if (backdrop.dataset.closeMode === 'navigate') {
            window.location.href = backdrop.dataset.closeHref;
            return;
        }
        backdrop.classList.remove('lp-modal-open');
    }

    document.querySelectorAll('[data-register-close]').forEach(function (el) {
        el.addEventListener('click', closeModal);
    });

    backdrop.addEventListener('click', function (e) {
        if (e.target === backdrop) {
            closeModal();
        }
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && backdrop.classList.contains('lp-modal-open')) {
            closeModal();
        }
    });
})();

function lpToggleRegisterPassword() {
    var field = document.getElementById('register-password-field');
    field.type = field.type === 'password' ? 'text' : 'password';
}

function lpToggleRegisterPasswordConfirm() {
    var field = document.getElementById('register-password-confirm-field');
    field.type = field.type === 'password' ? 'text' : 'password';
}
</script>
