{% extends 'app/base.html.twig' %}

{% block title %}Détail de la demande{% endblock %}

{% block body %}
    <div class="lp-page-header">
        <div class="lp-page-header-title">
            <h1>Demande de congé</h1>
            <span class="status-badge status-{{ demande.statut.value }}">{{ demande.statut.label }}</span>
        </div>
    </div>

    <div class="lp-feature-card">
        <div class="lp-info-grid">
            <div class="lp-info-item">
                <span class="lp-info-label">Employé</span>
                <span class="lp-info-value">{{ demande.employe.nomComplet }}</span>
            </div>
            <div class="lp-info-item">
                <span class="lp-info-label">Type</span>
                <span class="lp-info-value">{{ demande.typeConge.libelle }}</span>
            </div>
            <div class="lp-info-item">
                <span class="lp-info-label">Période</span>
                <span class="lp-info-value">{{ demande.dateDebut|date('d/m/Y') }} au {{ demande.dateFin|date('d/m/Y') }}</span>
            </div>
            <div class="lp-info-item">
                <span class="lp-info-label">Approbateur</span>
                <span class="lp-info-value">{{ demande.approbateur.nomComplet }}</span>
            </div>
            <div class="lp-info-item lp-info-item-full">
                <span class="lp-info-label">Description</span>
                <span class="lp-info-value">{{ demande.description|default('—') }}</span>
            </div>
        </div>
    </div>

    <div class="lp-dashboard-section">
        <h2 class="lp-dashboard-subhead">Pièces jointes</h2>
        <div class="lp-feature-card">
            {% if demande.piecesJointes is empty %}
                <p class="lp-empty-text">Aucune pièce jointe.</p>
            {% else %}
                {% for pj in demande.piecesJointes %}
                    <div class="lp-attachment-item">
                        <span class="lp-attachment-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 4h9l5 5v11a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/><path d="M14 4v5h5"/></svg>
                        </span>
                        <div>
                            <div class="lp-attachment-name">{{ pj.nomFichier }}</div>
                            <div class="lp-attachment-meta">Ajouté le {{ pj.dateAjout|date('d/m/Y') }}</div>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>

    {% if is_granted('DEMANDE_ENVOYER', demande) %}
        <form method="post" action="{{ path('demande_conge_envoyer', {id: demande.id}) }}" class="lp-show-actions" onsubmit="return confirm('Envoyer cette demande pour approbation ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('envoyer' ~ demande.id) }}">
            <button type="submit" class="lp-btn lp-btn-success">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12l4 4L19 6"/></svg>
                Valider (envoyer pour approbation)
            </button>
        </form>
    {% endif %}

    <a href="{{ path('demande_conge_index') }}" class="lp-see-more">&larr; Retour à mes demandes</a>
{% endblock %}
