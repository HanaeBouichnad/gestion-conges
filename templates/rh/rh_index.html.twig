{% extends 'base.html.twig' %}

{% block title %}Gestion des soldes{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Gestion des soldes par employé</h1>
    <ul class="list-group">
        {% for employe in employes %}
            <li class="list-group-item">
                <a href="{{ path('rh_solde_employe', {id: employe.id}) }}">{{ employe.nomComplet }}</a>
            </li>
        {% endfor %}
    </ul>
</div>
{% endblock %}