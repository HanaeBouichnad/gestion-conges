{% extends 'base.html.twig' %}

{% block title %}Modifier le solde{% endblock %}

{% block body %}
<div class="container mt-4" style="max-width: 500px;">
    <h1>Modifier le solde</h1>
    <p>{{ employe.nomComplet }} — {{ type.libelle }} — solde actuel : <strong>{{ solde.solde }}</strong> jours</p>

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit" class="btn btn-primary mt-3">Enregistrer</button>
    {{ form_end(form) }}
</div>
{% endblock %}