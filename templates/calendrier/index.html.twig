{% extends 'app/base.html.twig' %}

{% block title %}Calendrier des absences{% endblock %}

{% block body %}
    {% set moisAnnee = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] %}

    <div class="lp-page-header">
        <div>
            <h1>Calendrier</h1>
            <p class="lp-page-subtitle">Consultez vos congés et planifiez vos demandes.</p>
        </div>
        <div class="lp-month-nav">
            <a href="{{ path('calendrier_index', {mois: moisPrecedent.format('n'), annee: moisPrecedent.format('Y')}) }}" class="lp-icon-btn" title="Mois précédent">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg>
            </a>
            <span class="lp-month-label">{{ moisAnnee[mois - 1] }} {{ annee }}</span>
            <a href="{{ path('calendrier_index', {mois: moisSuivant.format('n'), annee: moisSuivant.format('Y')}) }}" class="lp-icon-btn" title="Mois suivant">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
            </a>
        </div>
    </div>

    <div class="lp-calendar-card">
        <div class="lp-calendar-weekdays">
            <span>Lun</span><span>Mar</span><span>Mer</span><span>Jeu</span><span>Ven</span><span>Sam</span><span>Dim</span>
        </div>

        <div class="lp-cal-weeks">
            {% for semaine in semaines %}
                {% set semaineIndex = loop.index0 %}
                <div class="lp-cal-week">
                    {% for jour in semaine %}
                        <div class="lp-cal-day {{ jour.dansMoisCourant ? '' : 'lp-cal-day-muted' }}" style="grid-column: {{ loop.index }}; grid-row: 1 / -1;">
                            <span class="lp-cal-day-number {{ jour.estAujourdhui ? 'lp-cal-day-today' : '' }}">{{ jour.jour }}</span>
                            {% if jour.estFerie %}<span class="lp-cal-day-ferie-dot" title="{{ jour.libelleFerie }}"></span>{% endif %}
                        </div>
                    {% endfor %}

                    {% for segment in barresParSemaine[semaineIndex] %}
                        <div
                            class="lp-cal-bar lp-cal-bar-{{ segment.statutValue }}"
                            style="grid-column: {{ segment.colStart }} / {{ segment.colEnd }}; grid-row: {{ segment.lane + 2 }};"
                            title="{{ segment.typeLibelle }} — {{ segment.statutLabel }}"
                        >
                            <strong>{{ segment.typeLibelle }}</strong>
                            <span>{{ segment.statutLabel }}</span>
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>

        <div class="lp-cal-legend">
            <span class="lp-legend-item"><span class="lp-legend-swatch lp-legend-swatch-brouillon"></span>Brouillon</span>
            <span class="lp-legend-item"><span class="lp-legend-swatch lp-legend-swatch-en_attente"></span>En attente</span>
            <span class="lp-legend-item"><span class="lp-legend-swatch lp-legend-swatch-approuve"></span>Approuvé</span>
            <span class="lp-legend-item"><span class="lp-legend-swatch lp-legend-swatch-refuse"></span>Refusé</span>
            <span class="lp-legend-item"><span class="lp-legend-swatch lp-legend-swatch-ferie"></span>Jour férié</span>
        </div>
    </div>
{% endblock %}
