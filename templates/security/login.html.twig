{% extends 'base.html.twig' %}

{% block title %}Connexion — Webodrop Congés{% endblock %}

{% block stylesheets %}
<style>
    body {
        background:
            radial-gradient(circle at 8% 15%, rgba(100,181,246,0.25), transparent 40%),
            radial-gradient(circle at 92% 85%, rgba(46,125,225,0.15), transparent 40%),
            #F7F9FC;
        min-height: 100vh;
    }
    .login-wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 2rem;
        position: relative;
    }
    .login-grid {
        display: flex;
        align-items: center;
        gap: 4rem;
        max-width: 1150px;
        width: 100%;
    }

    /* ---- Colonne gauche ---- */
    .login-intro { flex: 1; min-width: 340px; }
    .login-logo { margin-bottom: 2.2rem; }
    .login-logo img { height: 42px; display: block; }

    .login-badge {
        display: inline-block;
        background: #E9F1FD;
        color: #2E7DE1;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        padding: 0.4rem 0.9rem;
        border-radius: 999px;
        margin-bottom: 1.2rem;
    }
    .login-intro h1 {
        font-size: 2.6rem;
        font-weight: 800;
        color: #111827;
        line-height: 1.15;
        margin-bottom: 1rem;
    }
    .login-intro h1 span { color: #2E7DE1; }
    .login-intro p {
        color: #6B7280;
        font-size: 1.05rem;
        max-width: 420px;
        margin-bottom: 2.5rem;
    }

    .login-illustration { position: relative; width: 100%; max-width: 480px; }
    .login-illustration svg { width: 100%; height: auto; display: block; }

    .login-copyright {
        margin-top: 1.5rem;
        font-size: 0.85rem;
        color: #9CA3AF;
    }

    /* ---- Carte de connexion ---- */
    .login-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 25px 60px -15px rgba(17,24,39,0.15);
        padding: 2.6rem 2.4rem;
        width: 100%;
        max-width: 400px;
    }
    .login-card .card-logo {
        display: flex;
        justify-content: center;
        margin-bottom: 1.6rem;
    }
    .login-card .card-logo img { height: 50px; }

    .login-card h2 { font-size: 1.3rem; font-weight: 700; color: #111827; text-align: center; margin-bottom: 0.2rem; }
    .login-card .subtitle { text-align: center; color: #6B7280; font-size: 0.9rem; margin-bottom: 1.8rem; }

    .field-label { font-size: 0.82rem; font-weight: 600; color: #111827; margin-bottom: 0.35rem; display: block; }
    .field-icon-wrap { position: relative; margin-bottom: 1.2rem; }
    .field-icon-wrap svg {
        position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
        width: 18px; height: 18px; color: #9CA3AF;
    }
    .field-icon-wrap input {
        width: 100%;
        padding: 0.65rem 0.9rem 0.65rem 2.4rem;
        border: 1px solid #E5E9F0;
        border-radius: 10px;
        font-size: 0.95rem;
        box-sizing: border-box;
    }
    .field-icon-wrap input:focus {
        outline: none;
        border-color: #2E7DE1;
        box-shadow: 0 0 0 3px rgba(46,125,225,0.15);
    }
    .toggle-password {
        position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
        width: 18px; height: 18px; color: #9CA3AF; cursor: pointer; background: none; border: none; padding: 0;
    }

    .field-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.4rem;
        font-size: 0.85rem;
    }
    .field-row label { display: flex; align-items: center; gap: 0.4rem; color: #374151; cursor: pointer; }
    .field-row a { color: #2E7DE1; text-decoration: none; font-weight: 600; }
    .field-row a:hover { text-decoration: underline; }

    .btn-webodrop {
        background: #2E7DE1;
        border: none;
        color: #fff;
        font-weight: 600;
        font-size: 0.95rem;
        border-radius: 10px;
        padding: 0.75rem;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: background 0.15s ease;
        cursor: pointer;
    }
    .btn-webodrop:hover { background: #1E68C4; color: #fff; }

    .divider {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin: 1.6rem 0;
        color: #9CA3AF;
        font-size: 0.8rem;
    }
    .divider::before, .divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: #E5E9F0;
    }

    .btn-google {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        width: 100%;
        border: 1px solid #E5E9F0;
        background: #fff;
        border-radius: 10px;
        padding: 0.7rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: #374151;
        cursor: pointer;
        text-decoration: none;
    }
    .btn-google:hover { background: #F9FAFB; }

    .login-footer-link { text-align: center; margin-top: 1.6rem; font-size: 0.85rem; color: #6B7280; }
    .login-footer-link a { color: #2E7DE1; font-weight: 600; text-decoration: none; }
    .login-footer-link a:hover { text-decoration: underline; }

    @media (max-width: 900px) {
        .login-illustration { display: none; }
        .login-grid { flex-direction: column; gap: 2rem; text-align: center; }
        .login-intro p { margin-left: auto; margin-right: auto; }
        .login-logo { display: flex; justify-content: center; }
        .login-copyright { text-align: center; }
    }
</style>
{% endblock %}

{% block body %}
<div class="login-wrap">
    <div class="login-grid">

        {# ---------- Colonne gauche : présentation + illustration ---------- #}
        <div class="login-intro">
            <div class="login-logo">
                <img src="{{ asset('images/logo.png') }}" alt="Webodrop">
            </div>

            <span class="login-badge">SOLUTION DE GESTION DE CONGÉS</span>
            <h1>Connectez-vous <br>à votre <span>espace</span></h1>
            <p>Accédez à votre tableau de bord pour gérer vos demandes, consulter vos soldes et suivre vos congés en toute simplicité.</p>

            <div class="login-illustration">
                <svg viewBox="0 0 520 420" xmlns="http://www.w3.org/2000/svg">

                    {# points décoratifs #}
                    <g fill="#C7D6EE">
                        <circle cx="10" cy="20" r="3"/><circle cx="26" cy="20" r="3"/><circle cx="42" cy="20" r="3"/>
                        <circle cx="10" cy="36" r="3"/><circle cx="26" cy="36" r="3"/><circle cx="42" cy="36" r="3"/>
                        <circle cx="10" cy="52" r="3"/><circle cx="26" cy="52" r="3"/><circle cx="42" cy="52" r="3"/>
                    </g>

                    {# écran / fenêtre de navigateur #}
                    <rect x="70" y="40" width="260" height="200" rx="14" fill="#EEF3FB" stroke="#DCE7F7" stroke-width="2"/>
                    <rect x="70" y="40" width="260" height="30" rx="14" fill="#DCE7F7"/>
                    <circle cx="90" cy="55" r="4" fill="#fff"/>
                    <circle cx="104" cy="55" r="4" fill="#fff"/>

                    {# carte profil dans l'écran #}
                    <rect x="95" y="92" width="90" height="88" rx="10" fill="#fff"/>
                    <circle cx="140" cy="122" r="17" fill="#B9D3F5"/>
                    <path d="M115 165 q25 -22 50 0 z" fill="#B9D3F5"/>
                    <rect x="95" y="196" width="150" height="10" rx="5" fill="#fff"/>
                    <rect x="95" y="216" width="110" height="10" rx="5" fill="#fff"/>

                    {# pot de plante #}
                    <path d="M20 300 q-6 -55 40 -60 q46 5 40 60 z" fill="#1F2A4A"/>
                    <path d="M60 260 q6 -50 -28 -70 q-10 40 8 68z" fill="#2E7DE1"/>
                    <path d="M60 260 q-4 -46 20 -66 q14 34 -2 64z" fill="#4C8FE8"/>
                    <path d="M60 260 q-30 -32 -46 -34 q6 34 30 44z" fill="#7CAEF0"/>

                    {# bouclier avec cadenas #}
                    <path d="M255 175 l55 -24 l55 24 v52 c0 42 -30 66 -55 78 c-25 -12 -55 -36 -55 -78 z" fill="#3E7FE0"/>
                    <path d="M255 175 l55 -24 v154 c-25 -12 -55 -36 -55 -78 z" fill="#2E6FD1"/>
                    <rect x="288" y="222" width="44" height="32" rx="5" fill="#fff"/>
                    <path d="M296 222 v-11 a14 14 0 0 1 28 0 v11" fill="none" stroke="#fff" stroke-width="5"/>
                    <circle cx="310" cy="236" r="4" fill="#3E7FE0"/>
                    <rect x="307" y="238" width="6" height="10" rx="2" fill="#3E7FE0"/>

                    {# personnage #}
                    <ellipse cx="230" cy="392" rx="70" ry="8" fill="#E5EBF5"/>

                    {# jambes #}
                    <rect x="195" y="300" width="24" height="80" rx="10" fill="#1F2A4A"/>
                    <rect x="228" y="300" width="24" height="75" rx="10" fill="#28345C"/>
                    <rect x="188" y="372" width="38" height="16" rx="8" fill="#2E7DE1"/>
                    <rect x="222" y="368" width="38" height="16" rx="8" fill="#3E7FE0"/>

                    {# torse #}
                    <path d="M188 240 q40 -22 78 0 l10 68 q-50 24 -98 0 z" fill="#2E7DE1"/>

                    {# bras tendu vers le bouclier #}
                    <path d="M256 250 q30 -6 46 -18" stroke="#2E7DE1" stroke-width="20" stroke-linecap="round" fill="none"/>
                    <circle cx="306" cy="230" r="10" fill="#FFDCC2"/>

                    {# bras gauche #}
                    <path d="M198 250 q-14 20 -10 45" stroke="#2E7DE1" stroke-width="18" stroke-linecap="round" fill="none"/>
                    <circle cx="190" cy="298" r="9" fill="#FFDCC2"/>

                    {# tête #}
                    <circle cx="228" cy="216" r="26" fill="#FFDCC2"/>
                    <path d="M203 208 q4 -30 25 -30 q28 -2 26 26 q-4 -10 -14 -12 q-4 8 -14 8 q-14 0 -23 8z" fill="#1F2A4A"/>

                    {# badge "connexion sécurisée" #}
                    <rect x="150" y="330" width="200" height="62" rx="12" fill="#fff" stroke="#EDF1F8" stroke-width="1.5"/>
                    <circle cx="178" cy="352" r="11" fill="#22C55E"/>
                    <path d="M173 352 l4 4 l8 -9" stroke="#fff" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                    <text x="198" y="349" font-family="Arial, sans-serif" font-size="12" font-weight="700" fill="#111827">Connexion sécurisée</text>
                    <text x="198" y="365" font-family="Arial, sans-serif" font-size="10.5" fill="#9CA3AF">Vos données sont protégées</text>
                    <text x="198" y="378" font-family="Arial, sans-serif" font-size="10.5" fill="#9CA3AF">et confidentielles.</text>

                    {# cadenas décoratif à droite #}
                    <g opacity="0.5">
                        <rect x="470" y="330" width="30" height="22" rx="4" fill="#B9D3F5"/>
                        <path d="M476 330 v-8 a9 9 0 0 1 18 0 v8" fill="none" stroke="#B9D3F5" stroke-width="4"/>
                    </g>
                </svg>
            </div>

            <p class="login-copyright">© {{ "now"|date('Y') }} Webodrop - Tous droits réservés</p>
        </div>

        {# ---------- Colonne droite : formulaire ---------- #}
        <div class="login-card">
            <div class="card-logo">
                <img src="{{ asset('images/logo.png') }}" alt="Webodrop">
            </div>

            <h2>Bienvenue 👋</h2>
            <p class="subtitle">Connectez-vous à votre compte pour continuer</p>

            {% if error %}
                <div class="alert alert-danger" style="font-size: 0.85rem;">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post">
                <label class="field-label">Adresse e-mail</label>
                <div class="field-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                    <input type="email" name="_username" value="{{ last_username }}" placeholder="votre@email.com" required autofocus>
                </div>

                <label class="field-label">Mot de passe</label>
                <div class="field-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M7 10V7a5 5 0 0 1 10 0v3"/></svg>
                    <input type="password" name="_password" id="password-field" placeholder="••••••••••••" required>
                    <button type="button" class="toggle-password" onclick="togglePassword()">
                        <svg id="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>

                <div class="field-row">
                    <label>
                        <input type="checkbox" name="_remember_me" checked>
                        Se souvenir de moi
                    </label>
                    <a href="#">Mot de passe oublié ?</a>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn-webodrop">
                    Se connecter
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </button>
            </form>

            <div class="divider">ou continuer avec</div>

            <a href="#" class="btn-google">
                <svg width="18" height="18" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M23.52 12.27c0-.85-.08-1.66-.22-2.45H12v4.64h6.47c-.28 1.5-1.13 2.77-2.4 3.62v3h3.87c2.27-2.09 3.58-5.17 3.58-8.81z"/>
                    <path fill="#34A853" d="M12 24c3.24 0 5.96-1.07 7.94-2.92l-3.87-3c-1.08.72-2.45 1.15-4.07 1.15-3.13 0-5.78-2.11-6.73-4.96H1.28v3.11C3.25 21.3 7.31 24 12 24z"/>
                    <path fill="#FBBC05" d="M5.27 14.27a7.2 7.2 0 0 1 0-4.54v-3.1H1.28a12 12 0 0 0 0 10.75z"/>
                    <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.25 2.7 1.28 6.63l3.99 3.1C6.22 6.86 8.87 4.75 12 4.75z"/>
                </svg>
                Continuer avec Google
            </a>

            <p class="login-footer-link">Vous n'avez pas de compte ? <a href="#">Demander une démo</a></p>
        </div>
    </div>
</div>

<script>
function togglePassword() {
    const field = document.getElementById('password-field');
    field.type = field.type === 'password' ? 'text' : 'password';
}
</script>
{% endblock %}