{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="container mb-5">

    <div class="mb-4">
        <p class="text-uppercase mb-1" style="color: var(--color-muted); font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.08em;">{{ "now"|date('l d F Y') }}</p>
        <h1 class="mb-0">Bonjour, {{ app.user.prenom }}</h1>
    </div>

    {% if vueAdmin %}
        {# ---- Tableau de bord Admin ---- #}
        <div class="row g-3 mb-5">
            <div class="col-md-4">
                <div class="p-4 rounded-3" style="background: var(--color-surface); border-left: 4px solid var(--color-primary);">
                    <div class="font-display" style="font-size: 2rem;">{{ nbJoursFeries }}</div>
                    <div style="color: var(--color-muted);">Jours fériés configurés</div>
                    <a href="{{ path('admin_jour_ferie_index') }}" class="d-inline-block mt-2" style="font-size: 0.85rem;">Gérer &rarr;</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-3" style="background: var(--color-surface); border-left: 4px solid var(--color-primary-light);">
                    <div class="font-display" style="font-size: 2rem;">{{ nbTypesConge }}</div>
                    <div style="color: var(--color-muted);">Types de congé actifs</div>
                    <a href="{{ path('admin_type_conge_index') }}" class="d-inline-block mt-2" style="font-size: 0.85rem;">Gérer &rarr;</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-3" style="background: var(--color-surface); border-left: 4px solid var(--color-attente);">
                    <div class="font-display" style="font-size: 2rem;">{{ aApprouver|length }}</div>
                    <div style="color: var(--color-muted);">Demandes à approuver</div>
                    <a href="{{ path('approbation_index') }}" class="d-inline-block mt-2" style="font-size: 0.85rem;">Voir &rarr;</a>
                </div>
            </div>
        </div>

        {% if aApprouver is not empty %}
            <h2 class="mb-3" style="font-size: 1.2rem;">En attente de ta validation</h2>
            <div class="d-flex flex-column gap-2">
                {% for demande in aApprouver|slice(0, 5) %}
                    <div class="p-3 rounded-3 d-flex justify-content-between align-items-center" style="background: var(--color-surface);">
                        <div>
                            <strong>{{ demande.employe.nomComplet }}</strong> — {{ demande.typeConge.libelle }}
                            <span style="color: var(--color-muted);">({{ demande.dateDebut|date('d/m') }} au {{ demande.dateFin|date('d/m/Y') }})</span>
                        </div>
                        <a href="{{ path('approbation_index') }}" class="btn btn-stamp btn-sm">Traiter</a>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    {% else %}
        {# ---- Tableau de bord Employé / Responsable / RH ---- #}
        {% set counts = {'brouillon': 0, 'en_attente': 0, 'approuve': 0} %}
        {% for d in mesDemandes %}
            {% if d.statut.value in ['brouillon', 'en_attente', 'approuve'] %}
                {% set counts = counts|merge({(d.statut.value): counts[d.statut.value] + 1}) %}
            {% endif %}
        {% endfor %}

        <div class="row g-3 mb-5">
            <div class="col-6 col-md-3">
                <div class="p-3 rounded-3 text-center" style="background: var(--color-surface); border-left: 4px solid var(--color-brouillon);">
                    <div class="font-display" style="font-size: 1.8rem;">{{ counts.brouillon }}</div>
                    <div style="font-size: 0.75rem; color: var(--color-muted);">Brouillon</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 rounded-3 text-center" style="background: var(--color-surface); border-left: 4px solid var(--color-attente);">
                    <div class="font-display" style="font-size: 1.8rem;">{{ counts.en_attente }}</div>
                    <div style="font-size: 0.75rem; color: var(--color-muted);">En attente</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 rounded-3 text-center" style="background: var(--color-surface); border-left: 4px solid var(--color-approuve);">
                    <div class="font-display" style="font-size: 1.8rem;">{{ counts.approuve }}</div>
                    <div style="font-size: 0.75rem; color: var(--color-muted);">Approuvé</div>
                </div>
            </div>
            {% if is_granted('ROLE_RESPONSABLE') %}
                <div class="col-6 col-md-3">
                    <div class="p-3 rounded-3 text-center" style="background: var(--color-surface); border-left: 4px solid var(--color-primary);">
                        <div class="font-display" style="font-size: 1.8rem;">{{ aApprouver|length }}</div>
                        <div style="font-size: 0.75rem; color: var(--color-muted);">À approuver</div>
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="row g-4">
            <div class="col-md-7">
                <h2 class="mb-3" style="font-size: 1.2rem;">Demandes récentes</h2>
                {% if mesDemandes is empty %}
                    <div class="p-4 rounded-3 text-center" style="background: var(--color-surface); border: 1px dashed var(--color-muted);">
                        <p class="mb-2">Aucune demande pour le moment.</p>
                        <a href="{{ path('demande_conge_new') }}" class="btn btn-stamp btn-sm">+ Nouvelle demande</a>
                    </div>
                {% else %}
                    <div class="d-flex flex-column gap-2">
                        {% for demande in mesDemandes %}
                            <a href="{{ path('demande_conge_show', {id: demande.id}) }}" class="p-3 rounded-3 d-flex justify-content-between align-items-center text-decoration-none" style="background: var(--color-surface); color: var(--color-text);">
                                <div>
                                    <strong>{{ demande.typeConge.libelle }}</strong>
                                    <span style="color: var(--color-muted);">— {{ demande.dateDebut|date('d/m') }} au {{ demande.dateFin|date('d/m/Y') }}</span>
                                </div>
                                <span class="status-badge status-{{ demande.statut.value }}">{{ demande.statut.label }}</span>
                            </a>
                        {% endfor %}
                    </div>
                    <a href="{{ path('demande_conge_index') }}" class="d-inline-block mt-3">Voir toutes mes demandes &rarr;</a>
                {% endif %}
            </div>

            <div class="col-md-5">
                <h2 class="mb-3" style="font-size: 1.2rem;">Mon solde</h2>
                <div class="p-3 rounded-3" style="background: var(--color-surface);">
                    {% set totalJours = 0 %}
                    {% for s in mesSoldes %}{% set totalJours = totalJours + s.solde %}{% endfor %}

                    {% if totalJours > 0 %}
                        <div class="d-flex rounded-pill overflow-hidden mb-3" style="height: 14px;">
                            {% for s in mesSoldes %}
                                {% if s.solde > 0 %}
                                    <div style="width: {{ (s.solde / totalJours * 100) }}%; background: hsl({{ loop.index0 * 70 }}, 45%, 40%);"></div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endif %}

                    {% for s in mesSoldes %}
                        <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 0.88rem;">
                            <span><span class="d-inline-block me-2" style="width: 10px; height: 10px; border-radius: 50%; background: hsl({{ loop.index0 * 70 }}, 45%, 40%);"></span>{{ s.typeConge.libelle }}</span>
                            <strong>{{ s.solde }} j</strong>
                        </div>
                    {% endfor %}
                </div>
                <a href="{{ path('solde_mes_soldes') }}" class="d-inline-block mt-2">Détail des soldes &rarr;</a>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}