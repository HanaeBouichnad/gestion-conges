{% extends 'app/base.html.twig' %}

{% block title %}Mes demandes de congé{% endblock %}

{% block body %}
    <div class="lp-page-header">
        <h1>Mes demandes de congé</h1>
        <button type="button" class="lp-btn lp-btn-primary" data-nouvelle-demande data-nouvelle-demande-url="{{ path('demande_conge_new') }}" data-tous-soldes-nuls="{{ tousSoldesNuls ? '1' : '0' }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Nouvelle demande
        </button>
    </div>

    {% for message in app.flashes('success') %}
        <div class="lp-alert lp-alert-success">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M5 12l4 4L19 6"/></svg>
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="lp-alert lp-alert-error">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
            {{ message }}
        </div>
    {% endfor %}

    {% if demandes is empty %}
        <div class="lp-list-empty">
            <p>Aucune demande de congé pour le moment.</p>
        </div>
    {% else %}
        {% for demande in demandes %}
            <div class="lp-demande-card">
                <div class="lp-demande-card-info">
                    <strong>{{ demande.typeConge.libelle }}</strong>
                    <span class="lp-demande-card-meta">{{ demande.employe.nomComplet }} — {{ demande.dateDebut|date('d/m/Y') }} au {{ demande.dateFin|date('d/m/Y') }}</span>
                </div>
                <div class="lp-demande-card-side">
                    <span class="status-badge status-{{ demande.statut.value }}">{{ demande.statutLabel }}</span>
                    <div class="lp-demande-card-actions">
                        <a href="{{ path('demande_conge_show', {id: demande.id}) }}" class="lp-icon-btn" title="Voir">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                        </a>
                        {% if is_granted('DEMANDE_EDIT', demande) %}
                            <a href="{{ path('demande_conge_edit', {id: demande.id}) }}" class="lp-icon-btn" title="Modifier">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                            </a>
                        {% endif %}
                        {% if is_granted('DEMANDE_ENVOYER', demande) %}
                            <form method="post" action="{{ path('demande_conge_envoyer', {id: demande.id}) }}" data-confirm-message="Envoyer cette demande pour approbation ? Elle ne sera plus modifiable directement.">
                                <input type="hidden" name="_token" value="{{ csrf_token('envoyer' ~ demande.id) }}">
                                <button type="submit" class="lp-icon-btn lp-icon-btn-primary" title="Valider">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg>
                                </button>
                            </form>
                        {% endif %}
                        {% if is_granted('DEMANDE_ANNULATION_DEMANDER', demande) %}
                            <button type="button" class="lp-icon-btn" title="Demander l'annulation" data-annulation-trigger data-demande-id="{{ demande.id }}">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="m15 9-6 6M9 9l6 6"/></svg>
                            </button>
                        {% endif %}
                        {% if is_granted('DEMANDE_DELETE', demande) %}
                            <form method="post" action="{{ path('demande_conge_annuler', {id: demande.id}) }}" data-confirm-message="Annuler cette demande ?">
                                <input type="hidden" name="_token" value="{{ csrf_token('annuler' ~ demande.id) }}">
                                <button type="submit" class="lp-icon-btn lp-icon-btn-danger" title="Supprimer">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/></svg>
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
{% endblock %}

{% block modals %}
    {% include 'shared/demandes_conge/modal_annulation.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    document.addEventListener('click', function (event) {
        var bouton = event.target.closest('[data-nouvelle-demande]');
        if (!bouton) { return; }
        if (bouton.dataset.tousSoldesNuls === '1') {
            window.lpOuvrirErreur('Tous vos soldes de congé sont nuls. Vous ne pouvez créer aucune nouvelle demande.');
            return;
        }
        window.location.href = bouton.dataset.nouvelleDemandeUrl;
    });
    </script>
{% endblock %}