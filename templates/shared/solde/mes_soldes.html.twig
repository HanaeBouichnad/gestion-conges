{% extends 'app/base.html.twig' %}

{% block title %}Mes soldes de congé{% endblock %}

{% block body %}
    <div class="lp-page-header">
        <h1>Répartition de mon solde</h1>
    </div>

    <div class="lp-dashboard-section">
        <div class="lp-type-grid">
            {% for solde in soldes %}
                {% set libelleLower = solde.typeConge.libelle|lower %}
                {% if 'annuel' in libelleLower %}
                    {% set typeKey = 'annuel' %}
                {% elseif 'maladie' in libelleLower %}
                    {% set typeKey = 'maladie' %}
                {% elseif 'récup' in libelleLower or 'recup' in libelleLower %}
                    {% set typeKey = 'recuperation' %}
                {% elseif 'exceptionnel' in libelleLower %}
                    {% set typeKey = 'exceptionnel' %}
                {% elseif 'sans solde' in libelleLower %}
                    {% set typeKey = 'sans-solde' %}
                {% else %}
                    {% set typeKey = 'defaut' %}
                {% endif %}

                <div class="lp-type-card lp-type-card--{{ typeKey }}">
                    <svg class="lp-type-card-wave" viewBox="0 0 200 40" preserveAspectRatio="none">
                        <path d="M0 22 Q 50 4 100 22 T 200 22 V40 H0 Z"/>
                    </svg>

                    <div class="lp-type-card-icon">
                        {% if typeKey == 'annuel' %}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3C7 3 3 8 3 12h18C21 8 17 3 12 3z"/><path d="M12 12v7.5"/><path d="M9.5 19.5c0 .9 1.1 1.5 2.5 1.5s2.5-.6 2.5-1.5"/></svg>
                        {% elseif typeKey == 'maladie' %}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M12 8.5v6M9 11.5h6"/></svg>
                        {% elseif typeKey == 'recuperation' %}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 0 1 14.5-4.5"/><path d="M20 4v5h-5"/><path d="M20 12a8 8 0 0 1-14.5 4.5"/><path d="M4 20v-5h5"/></svg>
                        {% elseif typeKey == 'exceptionnel' %}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="9" width="16" height="11" rx="1.5"/><path d="M4 9h16M12 9v11"/><path d="M12 9C9.7 9 8 7.6 8 6a2 2 0 0 1 4 0 2 2 0 0 1 4 0c0 1.6-1.7 3-4 3z"/></svg>
                        {% elseif typeKey == 'sans-solde' %}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M6.5 6.5l11 11"/></svg>
                        {% else %}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 10h18"/></svg>
                        {% endif %}
                    </div>

                    <div class="lp-type-card-label">{{ solde.typeConge.libelle }}</div>
                    <div class="lp-type-card-value">{{ solde.solde }}<span>{{ solde.solde > 1 ? 'jours' : 'jour' }}</span></div>
                    <span class="lp-type-card-badge">Disponible</span>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
