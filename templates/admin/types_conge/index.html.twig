{% extends 'app/base.html.twig' %}

{% block title %}Types de congé{% endblock %}

{% block body %}
    <div class="lp-page-header">
        <div>
            <h1>Types de congé</h1>
            <p class="lp-page-subtitle">Gérez les différents types de congés</p>
        </div>
        <a href="{{ path('admin_type_conge_new') }}" class="lp-btn lp-btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Ajouter un type de congé
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="lp-alert lp-alert-success">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M5 12l4 4L19 6"/></svg>
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="lp-alert lp-alert-error">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
            {{ message }}
        </div>
    {% endfor %}

    {% if types is empty %}
        <div class="lp-list-empty">
            <p>Aucun type de congé pour le moment.</p>
            <a href="{{ path('admin_type_conge_new') }}" class="lp-btn lp-btn-primary lp-btn-sm">+ Nouveau type</a>
        </div>
    {% else %}
        <div class="lp-table-card">
            <table class="lp-table">
                <thead>
                    <tr>
                        <th>Type de congé</th>
                        <th class="lp-table-cell-wrap">Description</th>
                        <th>Pièce jointe obligatoire</th>
                        <th>Solde</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for type in types %}
                        <tr>
                            <td>{{ type.libelle }}</td>
                            <td class="lp-table-cell-wrap">{{ type.description }}</td>
                            <td>
                                <span class="lp-table-badge {{ type.pieceJointeObligatoire ? 'lp-table-badge-yes' : 'lp-table-badge-no' }}">
                                    {{ type.pieceJointeObligatoire ? 'Oui' : 'Non' }}
                                </span>
                            </td>
                            <td>{{ type.soldeMax is not null ? type.soldeMax ~ ' j.' : 'Illimité' }}</td>
                            <td>
                                <span class="lp-table-badge {{ type.actif ? 'lp-table-badge-yes' : 'lp-table-badge-no' }}">
                                    {{ type.actif ? 'Actif' : 'Inactif' }}
                                </span>
                            </td>
                            <td>
                                <div class="lp-table-actions">
                                    <a href="{{ path('admin_type_conge_edit', {id: type.id}) }}" class="lp-icon-btn" title="Modifier">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
