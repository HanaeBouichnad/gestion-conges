{% macro avatar(utilisateur) %}
    {% if utilisateur.photoUrl %}
        <img src="{{ utilisateur.photoUrl }}" alt="" class="lp-avatar">
    {% else %}
        <span class="lp-avatar lp-avatar-placeholder">{{ utilisateur.prenom|slice(0, 1) }}{{ utilisateur.nom|slice(0, 1) }}</span>
    {% endif %}
{% endmacro %}

{% macro roleBadge(utilisateur) %}
    {% if 'ROLE_ADMIN' in utilisateur.roles %}
        <span class="lp-role-badge lp-role-badge-admin">Administrateur</span>
    {% elseif 'ROLE_RH' in utilisateur.roles %}
        <span class="lp-role-badge lp-role-badge-rh">RH</span>
    {% elseif 'ROLE_RESPONSABLE' in utilisateur.roles %}
        <span class="lp-role-badge lp-role-badge-responsable">Responsable</span>
    {% else %}
        <span class="lp-role-badge lp-role-badge-employe">Employé</span>
    {% endif %}
{% endmacro %}
