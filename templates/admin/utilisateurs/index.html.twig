{% extends 'app/base.html.twig' %}
{% import 'admin/utilisateurs/_macros.html.twig' as m %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
    <div class="lp-page-header">
        <div>
            <h1>Utilisateurs</h1>
            <p class="lp-page-subtitle">Gérez les comptes et les rôles des utilisateurs</p>
        </div>
        <a href="{{ path('admin_user_new') }}" class="lp-btn lp-btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Ajouter un utilisateur
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="lp-alert lp-alert-success">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M5 12l4 4L19 6"/></svg>
            {{ message }}
        </div>
    {% endfor %}

    <div class="lp-users-toolbar">
        <form method="get" class="lp-search-input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="search" name="q" class="lp-search-input" placeholder="Rechercher un utilisateur..." value="{{ recherche }}">
        </form>
    </div>

    {% if utilisateurs is empty %}
        <div class="lp-list-empty">
            <p>Aucun utilisateur ne correspond à cette recherche.</p>
        </div>
    {% else %}
        <div class="lp-table-card">
            <table class="lp-table">
                <thead>
                    <tr>
                        <th>Utilisateur</th>
                        <th>Rôle</th>
                        <th>Email</th>
                        <th>Statut</th>
                        <th>Dernière connexion</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for utilisateur in utilisateurs %}
                        <tr>
                            <td>
                                <div class="lp-user-cell">
                                    {{ m.avatar(utilisateur) }}
                                    <span class="lp-user-cell-name">{{ utilisateur.nomComplet }}</span>
                                </div>
                            </td>
                            <td>{{ m.roleBadge(utilisateur) }}</td>
                            <td>{{ utilisateur.email }}</td>
                            <td>
                                <span class="lp-table-badge {{ utilisateur.actif ? 'lp-table-badge-yes' : 'lp-table-badge-no' }}">
                                    {{ utilisateur.actif ? 'Actif' : 'Inactif' }}
                                </span>
                            </td>
                            <td>{{ utilisateur.derniereConnexionAt ? utilisateur.derniereConnexionAt|date('d/m/Y H:i') : 'Jamais connecté' }}</td>
                            <td>
                                <div class="lp-row-menu" data-row-menu>
                                    <button type="button" class="lp-icon-btn" data-row-menu-toggle title="Actions">
                                        <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="12" cy="19" r="1.6"/></svg>
                                    </button>
                                    <div class="lp-row-menu-dropdown" data-row-menu-dropdown>
                                        <a href="{{ path('admin_user_edit', {id: utilisateur.id}) }}">Modifier</a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    <script>
    (function () {
        document.querySelectorAll('[data-row-menu]').forEach(function (menu) {
            var toggle = menu.querySelector('[data-row-menu-toggle]');
            var dropdown = menu.querySelector('[data-row-menu-dropdown]');
            toggle.addEventListener('click', function (e) {
                e.stopPropagation();
                var isOpen = dropdown.classList.contains('lp-row-menu-open');
                document.querySelectorAll('[data-row-menu-dropdown]').forEach(function (d) { d.classList.remove('lp-row-menu-open'); });
                if (!isOpen) { dropdown.classList.add('lp-row-menu-open'); }
            });
        });
        document.addEventListener('click', function () {
            document.querySelectorAll('[data-row-menu-dropdown]').forEach(function (d) { d.classList.remove('lp-row-menu-open'); });
        });
    })();
    </script>
{% endblock %}
