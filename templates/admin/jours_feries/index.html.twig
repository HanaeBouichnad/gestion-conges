{% extends 'app/base.html.twig' %}

{% block title %}Jours fériés{% endblock %}

{% block body %}
    <div class="lp-page-header">
        <div>
            <h1>Jours fériés</h1>
            <p class="lp-page-subtitle">Gérez les différents jours fériés</p>
        </div>
        <a href="{{ path('admin_jour_ferie_new') }}" class="lp-btn lp-btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Ajouter un jour férié
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="lp-alert lp-alert-success">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M5 12l4 4L19 6"/></svg>
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="lp-alert lp-alert-error">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
            {{ message }}
        </div>
    {% endfor %}

    {% if joursFeries is empty %}
        <div class="lp-list-empty">
            <p>Aucun jour férié pour le moment.</p>
            <a href="{{ path('admin_jour_ferie_new') }}" class="lp-btn lp-btn-primary lp-btn-sm">+ Nouveau jour férié</a>
        </div>
    {% else %}
        <div class="lp-table-card">
            <table class="lp-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Libellé</th>
                        <th>Récurrent</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for jf in joursFeries %}
                        <tr>
                            <td>{{ jf.date|date('d/m/Y') }}</td>
                            <td>{{ jf.libelle }}</td>
                            <td>
                                <span class="lp-table-badge {{ jf.recurrent ? 'lp-table-badge-yes' : 'lp-table-badge-no' }}">
                                    {{ jf.recurrent ? 'Oui' : 'Non' }}
                                </span>
                            </td>
                            <td>
                                <div class="lp-table-actions">
                                    <a href="{{ path('admin_jour_ferie_edit', {id: jf.id}) }}" class="lp-icon-btn" title="Modifier">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                                    </a>
                                    <form method="post" action="{{ path('admin_jour_ferie_delete', {id: jf.id}) }}" onsubmit="return confirm('Supprimer ce jour férié ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('supprimer' ~ jf.id) }}">
                                        <button type="submit" class="lp-icon-btn lp-icon-btn-danger" title="Supprimer">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
